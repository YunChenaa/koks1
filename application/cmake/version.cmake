function(extract_version)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/common/include/sys_version.h" file_contents)
    string(REGEX MATCH "SENSE_KOKS_VERSION_MAJOR ([0-9]+)" _ "${file_contents}")
    if(NOT CMAKE_MATCH_COUNT EQUAL 1)
        message(FATAL_ERROR "Could not extract major version number from version.hpp")
    endif()
    set(ver_major ${CMAKE_MATCH_1})

    string(REGEX MATCH "SENSE_KOKS_VERSION_MINOR ([0-9]+)" _ "${file_contents}")
    if(NOT CMAKE_MATCH_COUNT EQUAL 1)
        message(FATAL_ERROR "Could not extract minor version number from version.hpp")
    endif()

    set(ver_minor ${CMAKE_MATCH_1})
    string(REGEX MATCH "SENSE_KOKS_VERSION_PATCH ([0-9]+)" _ "${file_contents}")
    if(NOT CMAKE_MATCH_COUNT EQUAL 1)
        message(FATAL_ERROR "Could not extract patch version number from version.hpp")
    endif()
    set(ver_patch ${CMAKE_MATCH_1})

    set(VERSION_MAJOR ${ver_major} PARENT_SCOPE)
    set(VERSION_MINOR ${ver_minor} PARENT_SCOPE)
    set(VERSION_PATCH ${ver_patch} PARENT_SCOPE)
    set(SENSE_KOKS_VERSION "${ver_major}.${ver_minor}.${ver_patch}" PARENT_SCOPE)
endfunction()