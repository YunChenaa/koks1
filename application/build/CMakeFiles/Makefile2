rota/CMakeFiles/rota.dir/rule: cmake_check_build_system
	$(CMAKE_COMMAND) -E cmake_progress_start /home/songwei/koks1/application/build/CMakeFiles 17
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 rota/CMakeFiles/rota.dir/all
	$(CMAKE_COMMAND) -E cmake_progress_start /home/songwei/koks1/application/build/CMakeFiles 0
.PHONY : rota/CMakeFiles/rota.dir/rule

# Convenience name for target.
rota: rota/CMakeFiles/rota.dir/rule
.PHONY : rota

# clean rule for target.
rota/CMakeFiles/rota.dir/clean:
	$(MAKE) $(MAKESILENT) -f rota/CMakeFiles/rota.dir/build.make rota/CMakeFiles/rota.dir/clean
.PHONY : rota/CMakeFiles/rota.dir/clean

#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	$(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

